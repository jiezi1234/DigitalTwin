# OpenTelemetry 配置
OTEL_ENABLED=false
OTEL_TRACE_LEVEL=light
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:3100/otlp/v1/logs
# light: 仅追踪 LLM/DB 调用
# full: 追踪所有中间步骤
# custom: 通过 OTEL_CUSTOM_SPAN_PATTERNS 指定

# DashScope API
DASHSCOPE_API_KEY=your-api-key-here
CHAT_MODEL=qwen-plus
TUTOR_VL_MODEL=qwen-vl-plus
EMBED_MODEL=text-embedding-v4
MM_EMBED_MODEL=multimodal-embedding-v1
DASHSCOPE_TEXT_MAX_CONCURRENCY=2
DASHSCOPE_MM_MAX_CONCURRENCY=2

# RAG 优化
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode
LLM_REWRITING_MODEL=qwen-plus
RAG_QUERY_REWRITING_ENABLED=true
RAG_COREFERENCE_RESOLUTION_ENABLED=true
RAG_QUERY_HISTORY_MESSAGES=6
RAG_NEIGHBOR_EXPANSION_ENABLED=true
RAG_NEIGHBOR_WINDOW=2
RAG_NEIGHBOR_ANCHORS=5
RAG_NEIGHBOR_MAX_RESULTS=30
RAG_HYBRID_SEARCH_ENABLED=true
RAG_HYBRID_CANDIDATES=30
RAG_HYBRID_RRF_K=60
RAG_DENSE_WEIGHT=1.0
RAG_BM25_WEIGHT=1.0
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=qwen-turbo
RAG_RERANK_CANDIDATES=20
RAG_METADATA_FILTERING_ENABLED=true
RAG_TIMEZONE_OFFSET=+08:00
RAG_CONTEXT_RECORD_MAX_CHARS=500
RAG_CONTEXT_DEDUP_THRESHOLD=0.90
REACT_ENABLED=true
REACT_ROUTER_MODEL=qwen-turbo
REACT_HISTORY_MESSAGES=6
EVAL_TOP_K=5
EVAL_DATASET=./evaluation/retrieval_queries.jsonl
EVAL_OUTPUT_DIR=./evaluation/results
EVAL_QUERY_REWRITING_ENABLED=true
EVAL_ANSWER_DATASET=./evaluation/answer_cases.jsonl
EVAL_JUDGE_MODEL=qwen-turbo
EVAL_EVIDENCE_DATASET=./evaluation/evidence_calibration.jsonl

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_CHAT=wechat_embeddings
CHROMA_COLLECTION_TEXTBOOK=textbook_embeddings

# 数字助教
TUTOR_ENABLED=true
TUTOR_COLLECTION=textbook_embeddings
TUTOR_MM_TEXT_COLLECTION=textbook_mm_text_embeddings
TUTOR_MM_IMAGE_COLLECTION=textbook_mm_image_embeddings
TUTOR_OCR_TEXT_COLLECTION=textbook_ocr_text_embeddings
TUTOR_TEXT_TOP_K=8
TUTOR_IMAGE_TOP_K=4
TUTOR_OCR_TOP_K=8
TUTOR_HYBRID_SEARCH_ENABLED=true
TUTOR_BM25_CANDIDATES=30
TUTOR_RRF_K=60
TUTOR_MM_TEXT_WEIGHT=1.0
TUTOR_OCR_TEXT_WEIGHT=0.9
TUTOR_BM25_WEIGHT=0.8
TUTOR_RERANK_ENABLED=true
TUTOR_RERANK_MODEL=qwen-turbo
TUTOR_RERANK_CANDIDATES=20
TUTOR_MAX_CONTEXT_LENGTH=4000
TUTOR_MAX_TOKENS=1500
TUTOR_REQUIRE_EVIDENCE=true
TUTOR_NO_EVIDENCE_RESPONSE=当前教材资料中没有足够信息回答这个问题。
TUTOR_MIN_TEXT_EVIDENCE_SCORE=0.45
TUTOR_MIN_IMAGE_EVIDENCE_SCORE=0.45
TUTOR_MIN_EVIDENCE_ITEMS=1
TUTOR_MIN_CITATION_SUPPORT_SCORE=0.45
PDF_EXPORT_ROOT=./output
PDF_CHUNK_TARGET_CHARS=800
PDF_CHUNK_MAX_CHARS=1200
PDF_CHUNK_OVERLAP_BLOCKS=1

# RAG 参数
RAG_ENABLED=true
RAG_MAX_RESULTS=20
RAG_MAX_CONTEXT_LENGTH=2000
RAG_INCLUDE_METADATA=true

# 日志
LOG_LEVEL=INFO
CONSOLE_LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Flask
HOST=0.0.0.0
PORT=8080
FLASK_DEBUG=false
